{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nouns Money Workshop design",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "theme",
    "asset",
    "colors",
    "edition",
    "specimen"
  ],
  "properties": {
    "schemaVersion": {
      "const": "nmw-design/1"
    },
    "theme": {
      "enum": [
        "pacific",
        "workshop",
        "el-segundo"
      ]
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collection",
        "sourceCommit",
        "sourceSha256",
        "seed"
      ],
      "properties": {
        "collection": {
          "const": "nouns-cc0-local-seed"
        },
        "sourceCommit": {
          "const": "2213eea1c15f331f786784c2621d53bdecf907e2"
        },
        "sourceSha256": {
          "const": "a03f22b7838b35fdf0332617c9b8e2b032eb26cf1632afbefb200fec64c4bc20"
        },
        "seed": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "background",
            "body",
            "accessory",
            "head",
            "glasses"
          ],
          "properties": {
            "background": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1
            },
            "body": {
              "type": "integer",
              "minimum": 0,
              "maximum": 29
            },
            "accessory": {
              "type": "integer",
              "minimum": 0,
              "maximum": 142
            },
            "head": {
              "type": "integer",
              "minimum": 0,
              "maximum": 253
            },
            "glasses": {
              "type": "integer",
              "minimum": 0,
              "maximum": 22
            }
          }
        }
      }
    },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paper",
        "ink",
        "accent"
      ],
      "properties": {
        "paper": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        },
        "ink": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        }
      }
    },
    "edition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "number"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 28,
          "pattern": "^[A-Z0-9 .&-]+$"
        },
        "number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        }
      }
    },
    "specimen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "id"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256-canonical-v1-48"
        },
        "id": {
          "type": "string",
          "pattern": "^NMW1-[0-9A-F]{12}$"
        }
      }
    }
  }
}
