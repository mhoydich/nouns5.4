{
  "name": "nouns-web-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local browser prototype that renders authentic Nouns using the official CC0 asset set.",
  "scripts": {
    "build": "node ./scripts/build-client.mjs",
    "verify:open-ad-network": "node ./scripts/verify-open-ad-network.mjs",
    "verify:art-home": "node ./scripts/verify-art-home.mjs",
    "verify:open-studio": "node ./scripts/verify-open-studio-002.mjs",
    "verify:drum-jam": "node ./scripts/verify-drum-jam.mjs",
    "verify:permission-lab": "node ./scripts/verify-permission-lab.mjs",
    "verify:services": "node ./scripts/verify-services.mjs",
    "verify:playlist-role": "node ./scripts/verify-playlist-role.mjs",
    "verify:desk": "node ./scripts/verify-desk.mjs",
    "verify:product-desk": "node ./scripts/verify-product-desk.mjs",
    "verify:tag-open-build": "node ./scripts/verify-tag-open-build.mjs",
    "verify:market": "node ./scripts/verify-market.mjs",
    "verify:builder-001": "node ./scripts/verify-builder-001.mjs",
    "verify:issue-001": "node ./scripts/verify-issue-001.mjs",
    "verify:issue-002": "node ./scripts/verify-issue-002.mjs",
    "verify:credit-card-games": "node ./scripts/verify-credit-card-games.mjs",
    "verify:intern-read-001": "node ./scripts/verify-intern-read-001.mjs",
    "verify:early-career": "node ./scripts/verify-early-career.mjs",
    "start": "npm run build && wrangler pages dev public",
    "serve:static": "npm run build && node server.mjs",
    "sync:assets": "node ./scripts/sync-nouns-data.mjs",
    "cf:dev": "npm run build && wrangler pages dev public",
    "cf:project": "wrangler pages project create industrynext-nouns --production-branch main",
    "cf:deploy": "npm run build && wrangler pages deploy public --project-name industrynext-nouns",
    "cf:rooms:dev": "wrangler dev --config workers/jam-room-coordinator/wrangler.jsonc",
    "cf:rooms:deploy": "wrangler deploy --config workers/jam-room-coordinator/wrangler.jsonc"
  },
  "dependencies": {
    "@nouns/assets": "^0.10.0",
    "@nouns/sdk": "^1.2.0",
    "@taquito/beacon-wallet": "^24.2.0",
    "@taquito/taquito": "^24.2.0",
    "@taquito/utils": "^24.2.0",
    "@tezos-x/octez.connect-types": "^4.8.3",
    "buffer": "^6.0.3",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "util": "^0.12.5"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "wrangler": "^4.113.0"
  }
}
